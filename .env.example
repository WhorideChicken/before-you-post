# Standard mode: Muse Spark, SAM 3.1 and Muse Image on the Meta Model API. Empty: standard mode is off.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
# Private mode: Muse Spark Open on Baseten's Model API, edits on this server. Empty: private mode is off.
OPEN_API_KEY=
OPEN_MODEL=meta-models/muse-spark-open-1026
# Private mode's object outlines: SAM 3 open weights on Modal (app/sam3_modal.py prints the URL when deployed).
# Empty: private mode masks the attacker's box instead.
# SAM3_URL=
# SAM3_KEY=
# With no key at all only the recorded samples play. MOCK=1 runs the whole loop offline instead, with a placeholder
# attacker and OpenCV inpainting.
# MOCK=1
# Judges' code: when set, live runs on your own photos need it (the samples never do).
# LIVE_CODE=
# Live run limits: per visitor per hour, and for the whole site per day.
# RUNS_PER_HOUR=4
# RUNS_PER_DAY=30
# Attacker reasoning effort; "" uses the model default.
# ATTACK_EFFORT=low
